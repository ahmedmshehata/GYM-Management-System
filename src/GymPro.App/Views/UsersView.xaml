<UserControl x:Class="GymPro.App.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="Staff users" Style="{StaticResource Text.H1}" />
      <TextBlock Text="Reception: check-in, members, sales · Manager: + plans, cancellations, audit log · Admin: + users, legacy import" Style="{StaticResource Text.Muted}" />
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="320" />
      </Grid.ColumnDefinitions>

      <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="User" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Grid Width="26" Height="26" Margin="0,0,10,0">
                    <Ellipse Fill="{DynamicResource Brush.AccentSoft}" />
                    <TextBlock Text="{Binding DisplayName, Converter={StaticResource Initials}}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.AccentStrong}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock VerticalAlignment="Center"><Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding UserName, Mode=OneWay}" Foreground="{DynamicResource Brush.TextMuted}" /></TextBlock>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100" />
          <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" />
          <DataGridTextColumn Header="Last sign-in" Binding="{Binding LastLoginAtUtc, Converter={StaticResource UtcToLocal}}" Width="Auto" />
        </DataGrid.Columns>
      </DataGrid>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding Selected, Converter={StaticResource NullToCollapsed}}">
            <StackPanel>
              <TextBlock Text="{Binding Selected.UserName, StringFormat='Edit {0}'}" Style="{StaticResource Text.H2}" />
              <Label Content="Display name" />
              <TextBox Text="{Binding EditDisplayName}" />
              <Label Content="Role" />
              <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding EditRole}" />
              <CheckBox Content="Active" IsChecked="{Binding EditActive}" />
              <Button Content="Save changes" Command="{Binding UpdateCommand}" HorizontalAlignment="Left" Margin="0,0,0,14" />
              <Label Content="New temporary password" />
              <PasswordBox x:Name="ResetBox" />
              <Button Content="Reset password" Command="{Binding ResetPasswordCommand}" CommandParameter="{Binding ElementName=ResetBox}"
                      Style="{StaticResource Button.Danger}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Add a staff user" Style="{StaticResource Text.H2}" />
              <Label Content="User name" />
              <TextBox Text="{Binding NewUserName}" />
              <Label Content="Display name" />
              <TextBox Text="{Binding NewDisplayName}" />
              <Label Content="Role" />
              <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding NewRole}" />
              <Label Content="Temporary password" />
              <PasswordBox x:Name="NewBox" />
              <TextBlock Text="They'll be asked to choose their own password at first sign-in." Style="{StaticResource Text.Caption}" Margin="0,0,0,10" />
              <Button Content="Create user" Command="{Binding CreateCommand}" CommandParameter="{Binding ElementName=NewBox}"
                      Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
