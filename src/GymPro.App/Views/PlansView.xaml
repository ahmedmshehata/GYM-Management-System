<UserControl x:Class="GymPro.App.Views.PlansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <Button DockPanel.Dock="Right" Command="{Binding NewCommand}" Style="{StaticResource Button.Primary}" Margin="0" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE710;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,8,0" />
          <TextBlock Text="New plan" />
        </StackPanel>
      </Button>
      <StackPanel>
        <TextBlock Text="Plans" Style="{StaticResource Text.H1}" />
        <TextBlock Text="What you sell: monthly memberships and session packs. Price changes don't affect subscriptions already sold." Style="{StaticResource Text.Muted}" />
      </StackPanel>
    </DockPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="340" />
      </Grid.ColumnDefinitions>
      <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
          <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="110" />
          <DataGridTextColumn Header="Months" Binding="{Binding DurationMonths}" Width="70" />
          <DataGridTextColumn Header="Sessions" Binding="{Binding SessionCount}" Width="75" />
          <DataGridCheckBoxColumn Header="Expire" Binding="{Binding SessionsExpire}" Width="60" />
          <DataGridCheckBoxColumn Header="Pause" Binding="{Binding AllowPause}" Width="55" />
          <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N0}" Width="80" />
          <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" />
        </DataGrid.Columns>
      </DataGrid>

      <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding Edit, Converter={StaticResource NullToVisible}}">
        <TextBlock Text="Select a plan to edit, or create a new one." Style="{StaticResource Text.Muted}" VerticalAlignment="Center" TextAlignment="Center" />
      </Border>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding Edit, Converter={StaticResource NullToCollapsed}}">
      <Border Style="{StaticResource Card}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Plan details" Style="{StaticResource Text.H2}" />
          <Label Content="Name" />
          <TextBox Text="{Binding Edit.Name}" />
          <Label Content="Kind" />
          <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Edit.Kind}" />
          <Label Content="Sessions (session packs only)" />
          <TextBox Text="{Binding Edit.SessionCount, TargetNullValue=''}" />
          <CheckBox Content="Expire after the valid period" IsChecked="{Binding Edit.SessionsExpire}"
                    ToolTip="Unticked: the pack never expires and simply counts down per session, across any months" />
          <Label Content="Valid for (months)" />
          <TextBox Text="{Binding Edit.DurationMonths}" />

          <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,4,0,12" />
          <CheckBox x:Name="PauseBox" Content="Can be paused (freeze)" IsChecked="{Binding Edit.AllowPause}"
                    ToolTip="Members can pause, e.g. for travel or injury. Paused days are added to the end date." />
          <Label Content="Max pause days per subscription" />
          <TextBox Text="{Binding Edit.MaxPauseDays}" IsEnabled="{Binding IsChecked, ElementName=PauseBox}" />
          <Label Content="Price" />
          <TextBox Text="{Binding Edit.Price}" />
          <CheckBox Content="Active (can be sold)" IsChecked="{Binding Edit.IsActive}" />
          <Button Content="Save plan" Command="{Binding SaveCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,6,0,0" />
        </StackPanel>
      </Border>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
