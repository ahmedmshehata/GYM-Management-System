<Window x:Class="GymPro.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:GymPro.App.Views"
        xmlns:vm="clr-namespace:GymPro.App.ViewModels"
        Style="{StaticResource Window.Themed}"
        Title="{Binding Branding.Title}" Icon="{Binding Branding.Logo}"
        Width="1280" Height="800" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!-- Page view models map to their views; the nav rail swaps DataContext, WPF picks the view. -->
    <DataTemplate DataType="{x:Type vm:CheckInViewModel}"><v:CheckInView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:MembersViewModel}"><v:MembersView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PlansViewModel}"><v:PlansView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:UsersViewModel}"><v:UsersView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AuditViewModel}"><v:AuditView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ImportViewModel}"><v:ImportView /></DataTemplate>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding NavigateCommand}" CommandParameter="1" />
    <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding NavigateCommand}" CommandParameter="2" />
    <KeyBinding Modifiers="Ctrl" Key="D3" Command="{Binding NavigateCommand}" CommandParameter="3" />
    <KeyBinding Modifiers="Ctrl" Key="D4" Command="{Binding NavigateCommand}" CommandParameter="4" />
    <KeyBinding Modifiers="Ctrl" Key="D5" Command="{Binding NavigateCommand}" CommandParameter="5" />
    <KeyBinding Modifiers="Ctrl" Key="D6" Command="{Binding NavigateCommand}" CommandParameter="6" />
    <KeyBinding Key="F2" Command="{Binding NavigateCommand}" CommandParameter="1" />
  </Window.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===================== header -->
    <Border Background="{DynamicResource Brush.Header}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="6,0,12,0" Height="56">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ThemeButton" Style="{StaticResource Button.Header}" Click="OnToggleThemes" ToolTip="Appearance / theme" MinHeight="40">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE790;" Style="{StaticResource Text.Icon}" />
              <TextBlock Text="Theme" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Width="1" Height="24" Background="{DynamicResource Brush.HeaderHover}" Margin="6,0" />
          <Grid Width="32" Height="32" Margin="6,0,8,0">
            <!-- header-relative colours: the header itself may be the accent colour (Office, Material) -->
            <Ellipse Fill="{DynamicResource Brush.HeaderHover}" Stroke="{DynamicResource Brush.HeaderMuted}" StrokeThickness="1" />
            <TextBlock Text="{Binding UserName, Converter={StaticResource Initials}}" Foreground="{DynamicResource Brush.OnHeader}"
                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBlock Text="{Binding UserName}" Foreground="{DynamicResource Brush.OnHeader}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding RoleText}" Foreground="{DynamicResource Brush.HeaderMuted}" FontSize="11" />
          </StackPanel>
          <Button Style="{StaticResource Button.Header}" Click="OnChangePassword" ToolTip="Change password" MinHeight="40">
            <TextBlock Text="&#xE8D7;" Style="{StaticResource Text.Icon}" />
          </Button>
          <Button Style="{StaticResource Button.Header}" Click="OnSignOut" ToolTip="Sign out" MinHeight="40">
            <TextBlock Text="&#xE7E8;" Style="{StaticResource Text.Icon}" />
          </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource Button.Header}" Command="{Binding ToggleNavCommand}" ToolTip="Collapse / expand menu" MinHeight="40" Width="44">
            <TextBlock Text="&#xE700;" Style="{StaticResource Text.Icon}" />
          </Button>
          <Image Source="{Binding Branding.Logo}" Height="34" MaxWidth="140" Stretch="Uniform" Margin="8,0,10,0"
                 Visibility="{Binding Branding.Logo, Converter={StaticResource NullToCollapsed}}" />
          <TextBlock Text="{Binding Branding.Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"
                     Foreground="{DynamicResource Brush.OnHeader}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Appearance picker -->
    <Popup x:Name="ThemePopup" PlacementTarget="{Binding ElementName=ThemeButton}" Placement="Bottom" HorizontalOffset="-420"
           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Style="{StaticResource Card}" Width="560" Margin="0,4,12,12" Effect="{DynamicResource Effect.Popup}"
              TextElement.Foreground="{DynamicResource Brush.Text}" TextElement.FontFamily="{DynamicResource Font.Family}">
        <StackPanel>
          <TextBlock Text="Appearance" Style="{StaticResource Text.H2}" />
          <TextBlock Text="Your choice is saved to your account and follows you to any PC." Style="{StaticResource Text.Caption}" Margin="0,-6,0,10" />
          <ListBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" ItemContainerStyle="{StaticResource Swatch.Item}"
                   BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ThemeOption}">
                <StackPanel Width="118">
                  <!-- miniature of the app in that theme -->
                  <Border Height="70" CornerRadius="5" Background="{Binding Window}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.ColumnSpan="2" Background="{Binding Header}" CornerRadius="4,4,0,0" />
                      <Border Grid.Row="1" Background="{Binding Nav}" />
                      <Border Grid.Row="1" Grid.Column="1" Margin="6" Background="{Binding Surface}" CornerRadius="3">
                        <StackPanel Margin="5">
                          <Border Height="4" Width="44" HorizontalAlignment="Left" Background="{Binding Text}" Opacity="0.7" CornerRadius="2" />
                          <Border Height="4" Width="30" HorizontalAlignment="Left" Background="{Binding Text}" Opacity="0.35" CornerRadius="2" Margin="0,4,0,0" />
                          <Border Height="9" Width="34" HorizontalAlignment="Left" Background="{Binding Accent}" CornerRadius="2" Margin="0,6,0,0" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Border>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Margin="2,5,0,0" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Family}" Style="{StaticResource Text.Caption}" Margin="2,0,0,2" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <CheckBox Content="Use the gym's brand colour" IsChecked="{Binding UseBrandAccent}" IsEnabled="{Binding BrandAccentAllowed}" Margin="4,10,0,0" />
        </StackPanel>
      </Border>
    </Popup>

    <!-- ===================== body -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- navigation rail -->
      <Border Background="{DynamicResource Brush.Nav}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Width" Value="232" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                <Setter Property="Width" Value="60" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <DockPanel Margin="0,10,0,10">
          <TextBlock DockPanel.Dock="Bottom" Text="F2 check-in · Ctrl+1-6 pages" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.OnNav}"
                     Opacity="0.7" Margin="16,0" TextWrapping="Wrap"
                     Visibility="{Binding IsNavCollapsed, Converter={StaticResource InverseBoolToVisibility}}" />
          <ListBox Style="{StaticResource Nav.List}" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:NavItem}">
                <StackPanel Orientation="Horizontal" ToolTip="{Binding Shortcut}">
                  <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="17" Width="24" />
                  <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center"
                             Visibility="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- page -->
      <ContentControl Grid.Column="1" Content="{Binding SelectedPage.Page}" Margin="24,20,24,20" Focusable="False" />

      <!-- toasts -->
      <ItemsControl x:Name="ToastHost" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,8,0,0" MinWidth="280" MaxWidth="440" Effect="{DynamicResource Effect.Popup}">
              <DockPanel>
                <Border DockPanel.Dock="Left" Width="4" Style="{StaticResource Badge}" CornerRadius="0" Padding="0" HorizontalAlignment="Stretch" />
                <Border DockPanel.Dock="Left" Style="{StaticResource Badge}" Margin="12,0,0,0" Padding="4" CornerRadius="12">
                  <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="13" />
                </Border>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="10,12,16,12" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Grid>
</Window>
