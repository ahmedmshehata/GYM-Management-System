<Window x:Class="GymPro.App.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Themed}"
        Title="Change password" Width="380" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
  <StackPanel Margin="28,24">
    <TextBlock Text="Change password" Style="{StaticResource Text.H2}" />
    <TextBlock x:Name="Hint" Style="{StaticResource Text.Muted}" Margin="0,0,0,14" Visibility="Collapsed"
               Text="Your password was set by an administrator. Choose your own password to continue." />
    <Label Content="Current password" />
    <PasswordBox x:Name="CurrentBox" />
    <Label Content="New password" />
    <PasswordBox x:Name="NewBox" />
    <Label Content="Confirm new password" />
    <PasswordBox x:Name="ConfirmBox" />
    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,0,0,10" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" Style="{StaticResource Button.Subtle}" />
      <Button Content="Change password" IsDefault="True" Style="{StaticResource Button.Primary}" Click="OnOk" Margin="0" />
    </StackPanel>
  </StackPanel>
</Window>
