<UserControl x:Class="GymPro.App.Views.CheckInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.InputBindings>
    <KeyBinding Modifiers="Ctrl" Key="Return" Command="{Binding CheckInCommand}" />
  </UserControl.InputBindings>

  <DockPanel>
    <!-- page header -->
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="Check-in" Style="{StaticResource Text.H1}" />
      <TextBlock Text="Type a card number, name or phone and press Enter. Ctrl+Enter checks the member in." Style="{StaticResource Text.Muted}" />
    </StackPanel>

    <!-- today at a glance -->
    <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="0,0,0,16">
      <UniformGrid.Resources>
        <Style x:Key="StatValue" TargetType="TextBlock">
          <Setter Property="FontSize" Value="26" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
      </UniformGrid.Resources>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="&#xE8FB;" Style="{StaticResource Text.Icon}" FontSize="22" Foreground="{DynamicResource Brush.AccentStrong}" VerticalAlignment="Top" />
          <StackPanel>
            <TextBlock Text="Check-ins today" Style="{StaticResource Text.Muted}" />
            <TextBlock Text="{Binding Stats.CheckInsToday, FallbackValue='–'}" Style="{StaticResource StatValue}" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="&#xE716;" Style="{StaticResource Text.Icon}" FontSize="22" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Top" />
          <StackPanel>
            <TextBlock Text="Active members" Style="{StaticResource Text.Muted}" />
            <TextBlock Text="{Binding Stats.ActiveMembers, FallbackValue='–'}" Style="{StaticResource StatValue}" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="&#xE823;" Style="{StaticResource Text.Icon}" FontSize="22" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Top" />
          <StackPanel>
            <TextBlock Text="Expiring within 7 days" Style="{StaticResource Text.Muted}" />
            <TextBlock Text="{Binding Stats.ExpiringSoon, FallbackValue='–'}" Style="{StaticResource StatValue}" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="&#xE8C7;" Style="{StaticResource Text.Icon}" FontSize="22" Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Top" />
          <StackPanel>
            <TextBlock Text="Balances due" Style="{StaticResource Text.Muted}" />
            <TextBlock Text="{Binding Stats.BalancesDue, StringFormat=N0, FallbackValue='–'}" Style="{StaticResource StatValue}" />
          </StackPanel>
        </DockPanel>
      </Border>
    </UniformGrid>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- search -->
      <Border Style="{StaticResource Card}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Command="{Binding FindCommand}" IsDefault="True" Style="{StaticResource Button.Primary}" Margin="8,0,0,10" MinWidth="0">
              <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" />
            </Button>
            <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" FontSize="16"
                     ToolTip="Card number, name or phone (F2)" />
          </DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Style="{StaticResource Text.Muted}" Margin="0,0,0,8"
                     Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" />
          <DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedMember}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="No." Binding="{Binding MemberNo}" Width="60" />
              <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*" />
              <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="110" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>

      <!-- empty state -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding Detail, Converter={StaticResource NullToVisible}}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
          <TextBlock Text="&#xE8FB;" Style="{StaticResource Text.Icon}" FontSize="48" Foreground="{DynamicResource Brush.AccentStrong}" Margin="0,0,0,12" />
          <TextBlock Text="Ready for the next member" Style="{StaticResource Text.H2}" HorizontalAlignment="Center" />
          <TextBlock Style="{StaticResource Text.Muted}" TextAlignment="Center"
                     Text="Search on the left. When one member matches, they open here automatically with their subscriptions." />
        </StackPanel>
      </Border>

      <!-- member -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid DockPanel.Dock="Left" Width="96" Height="96" Margin="0,0,16,0">
              <Ellipse Fill="{DynamicResource Brush.SurfaceAlt}" Stroke="{DynamicResource Brush.Border}" />
              <Image Source="{DynamicResource Image.MemberPlaceholder}" Margin="18" Stretch="Uniform" />
              <Ellipse>
                <Ellipse.Fill>
                  <ImageBrush ImageSource="{Binding Detail.Photo.Data, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" />
                </Ellipse.Fill>
              </Ellipse>
            </Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Detail.FullName}" Style="{StaticResource Text.H1}" />
              <TextBlock Style="{StaticResource Text.Muted}">
                <Run Text="#" /><Run Text="{Binding Detail.MemberNo, Mode=OneWay}" />
                <Run Text="  ·  " /><Run Text="{Binding Detail.Phone, Mode=OneWay}" />
              </TextBlock>
              <Border Style="{StaticResource Badge}" Margin="0,8,0,0" Background="{DynamicResource Brush.DangerSoft}"
                      Visibility="{Binding HasBalanceDue, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Foreground="{DynamicResource Brush.Danger}" Text="{Binding BalanceDue, StringFormat='Balance due: {0:N0}'}" />
              </Border>
            </StackPanel>
          </DockPanel>

          <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button Command="{Binding CheckInCommand}" Style="{StaticResource Button.Primary}" FontSize="16" MinHeight="46" Padding="28,0"
                    ToolTip="Ctrl+Enter">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE73E;" Style="{StaticResource Text.Icon}" Margin="0,0,10,0" />
                <TextBlock Text="Check in" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock Text="Select an active subscription to enable check-in." Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
          </DockPanel>

          <DataGrid ItemsSource="{Binding Subscriptions}" SelectedItem="{Binding SelectedSubscription}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Plan" Binding="{Binding PlanName}" Width="1.3*" MinWidth="110" />
              <DataGridTextColumn Header="Ends" Binding="{Binding EndsText}" Width="Auto" />
              <DataGridTextColumn Header="Remaining" Binding="{Binding Remaining}" Width="*" MinWidth="100" />
              <DataGridTemplateColumn Header="Status" Width="125">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Badge}">
                      <TextBlock Text="{Binding StatusText}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
