<Window x:Class="GymPro.App.Views.CameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Themed}"
        Title="Take photo" Width="620" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20">
    <DockPanel Margin="0,0,0,12">
      <ComboBox x:Name="CameraBox" DockPanel.Dock="Right" Width="260" Margin="0" DisplayMemberPath="Name"
                SelectionChanged="OnCameraChanged" ToolTip="Camera" />
      <TextBlock Text="Take photo" Style="{StaticResource Text.H2}" Margin="0" VerticalAlignment="Center" />
    </DockPanel>

    <Border Style="{StaticResource Card}" Padding="0" Height="420" ClipToBounds="True" Background="#FF111111">
      <Grid>
        <!-- mirrored like a selfie camera so people can position themselves; the saved photo is not mirrored -->
        <Image x:Name="Preview" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
          <Image.RenderTransform>
            <ScaleTransform ScaleX="-1" />
          </Image.RenderTransform>
        </Image>
        <Image x:Name="Captured" Stretch="Uniform" Visibility="Collapsed" />
        <!-- square guide = the part that is saved -->
        <Border x:Name="Guide" Width="380" Height="380" BorderBrush="#AAFFFFFF" BorderThickness="2" CornerRadius="190" IsHitTestVisible="False" />
        <StackPanel x:Name="MessagePanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Visibility="Collapsed">
          <TextBlock Text="&#xE722;" Style="{StaticResource Text.Icon}" FontSize="42" Foreground="#CCFFFFFF" Margin="0,0,0,12" />
          <TextBlock x:Name="MessageText" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" />
        </StackPanel>
      </Grid>
    </Border>

    <DockPanel Margin="0,14,0,0">
      <Button Content="Cancel" IsCancel="True" DockPanel.Dock="Right" Style="{StaticResource Button.Subtle}" Margin="0" />
      <StackPanel Orientation="Horizontal">
        <Button x:Name="CaptureButton" Style="{StaticResource Button.Primary}" Click="OnCapture" IsDefault="True" IsEnabled="False" MinHeight="40">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE722;" Style="{StaticResource Text.Icon}" FontSize="14" Margin="0,0,8,0" />
            <TextBlock Text="Capture" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="RetakeButton" Content="Retake" Click="OnRetake" Visibility="Collapsed" MinHeight="40" />
        <Button x:Name="UseButton" Content="Use this photo" Style="{StaticResource Button.Primary}" Click="OnUse" Visibility="Collapsed" MinHeight="40" />
      </StackPanel>
    </DockPanel>
  </StackPanel>
</Window>
