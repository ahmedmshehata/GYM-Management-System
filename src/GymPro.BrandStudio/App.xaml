<Application x:Class="GymPro.BrandStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GymPro.BrandStudio"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- Brand Studio's own, deliberately neutral look: it is a reseller tool, not part of any brand. -->
    <SolidColorBrush x:Key="Studio.Window" Color="#F3F4F6" />
    <SolidColorBrush x:Key="Studio.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Studio.Border" Color="#D1D5DB" />
    <SolidColorBrush x:Key="Studio.Text" Color="#111827" />
    <SolidColorBrush x:Key="Studio.Muted" Color="#4B5563" />
    <SolidColorBrush x:Key="Studio.Accent" Color="#334155" />
    <SolidColorBrush x:Key="Studio.Error" Color="#B42318" />
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <local:BoolToBrushConverter x:Key="PassBrush" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style TargetType="Label">
      <Setter Property="Padding" Value="0,0,0,3" />
      <Setter Property="Foreground" Value="{StaticResource Studio.Muted}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="{StaticResource Studio.Border}" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,4,0,4" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="MinWidth" Value="80" />
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Studio.Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Studio.Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="FieldError" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Studio.Error}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Studio.Muted}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,4,0,8" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Studio.Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Studio.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16" />
    </Style>
  </Application.Resources>
</Application>
