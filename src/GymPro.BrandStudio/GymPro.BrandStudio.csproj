<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>BrandStudio</AssemblyName>
    <RootNamespace>GymPro.BrandStudio</RootNamespace>
    <Product>Brand Studio</Product>
    <AssemblyTitle>Brand Studio</AssemblyTitle>
    <ApplicationIcon>Assets\BrandStudio.ico</ApplicationIcon>
    <!-- CA1859: RelayCommand methods must return Task. -->
    <NoWarn>$(NoWarn);CA1859</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GymPro.Core\GymPro.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <!-- Window/taskbar icon. Sources: Assets/brand-studio-icon.svg (48 px+) and brand-studio-icon-small.svg (16-32 px). -->
    <Resource Include="Assets\BrandStudio.ico" />
  </ItemGroup>
</Project>
