<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- CA1848/CA1873: LoggerMessage delegates are overkill for a desktop app. CA2007: no ConfigureAwait in UI code. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2007;CA1515;CA1711;CA1002;CA2227;CA1819;CA1031;CA1303;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1862;CA1716</NoWarn>
    <Company>GymPro</Company>
    <Product>GymPro</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
